# 발급 전에는 비워두세요. 비어 있으면 전체 화면이 Mock 데이터로 작동합니다.
SEOUL_API_KEY=

# 향후 지하철 도착정보 확장용입니다. 현재 MVP에서는 사용하지 않습니다.
SEOUL_SUBWAY_API_KEY=

# 서울 실시간 인구 API의 장소별 캐시 시간(초).
# 10개 장소 × 15분 캐시를 기본으로 해 무료 호출량을 보호합니다.
SEOUL_API_CACHE_SECONDS=900

# 한 번에 실데이터를 조회할 장소 수. 현재 등록 장소 수는 10개입니다.
SEOUL_LIVE_PLACE_LIMIT=10

# SEO canonical / sitemap에 사용할 배포 주소
NEXT_PUBLIC_SITE_URL=http://localhost:3000
